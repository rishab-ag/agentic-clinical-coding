# Optional two-stage adapter. No key means conservative offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=
# Configure the supported context window of the chosen model.
OPENAI_CONTEXT_LIMIT=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_SECONDS=
OPENAI_RETRIES=1
CLINICAL_CONCURRENCY=1

# Choose gemini to use a Google AI Studio key; never commit .env.
MODEL_PROVIDER=openai
GEMINI_API_KEY=
# Optional overrides; unset uses gemini-3.5-flash-lite, 1048576, 16384 and 120.
GEMINI_MODEL=
GEMINI_CONTEXT_LIMIT=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_TIMEOUT_SECONDS=
GEMINI_RETRIES=1
